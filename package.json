{
  "name": "dialogic-voice-partner",
  "version": "0.1.0",
  "private": true,
  "description": "Voice production companion for Dialogic timelines",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "gen:types": "node scripts/gen-api-types.mjs",
    "service:install": "uv sync --project service",
    "service:dev": "uv run --project service uvicorn app.main:app --app-dir service --host 127.0.0.1 --port 3900 --reload"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
